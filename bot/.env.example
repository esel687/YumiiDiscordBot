# Discord bot
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Shared secret: set the SAME random value in Bot Hosting and Vercel.
# Never commit a real value or send it in chat.
MOONBOT_API_SECRET=

# Use the port assigned by your bot host. If the host sets PORT automatically,
# MOONBOT_API_PORT can be left empty.
MOONBOT_API_PORT=

# Optional: enables AI-based insult/harassment moderation.
# Configure this only through an adult-managed API account.
OPENAI_API_KEY=
